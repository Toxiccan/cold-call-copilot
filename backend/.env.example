# Supabase project URL and backend-only secret/service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-secret-key

# Comma-separated frontend origins allowed by the backend.
FRONTEND_ORIGIN=http://localhost:5173

# Optional: leave empty to use the local fallback suggestions.
# Create a Gemini API key in Google AI Studio and paste it without quotes/spaces.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
